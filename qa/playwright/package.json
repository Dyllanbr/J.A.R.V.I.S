{
  "name": "@jarvis/qa-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "allowScripts": {
    "fsevents": false
  },
  "scripts": {
    "test": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:validate": "redocly lint ../../contracts/openapi/openapi.yaml --extends=minimal"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.1",
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0"
  }
}
