# Server
JARVIS_HTTP_ADDRESS=127.0.0.1:8080
JARVIS_SHUTDOWN_TIMEOUT=10s

# API smoke tests
JARVIS_API_BASE_URL=http://127.0.0.1:8080

# Local PostgreSQL development (values are fictitious; export them explicitly)
JARVIS_POSTGRES_DB=jarvis_local
JARVIS_POSTGRES_USER=jarvis_local
JARVIS_POSTGRES_PASSWORD=replace-with-local-only-value
JARVIS_POSTGRES_PORT=55432
JARVIS_DATABASE_URL=postgres://jarvis_local:replace-with-local-only-value@127.0.0.1:55432/jarvis_local?sslmode=disable
JARVIS_DB_MAX_CONNS=4
JARVIS_DB_MIN_CONNS=0
JARVIS_DB_CONNECT_TIMEOUT=5s
JARVIS_DB_OPERATION_TIMEOUT=5s
